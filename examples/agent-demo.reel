---
# The launch-story edit (SPEC §13): 42 seconds of raw agent session become
# ~18 seconds of demo. Render the raw cast next to this for the before/after:
#
#   reel render examples/agent-session.cast -o before.gif   # 42s, drags
#   reel render examples/agent-demo.reel                    # 13s, tells a story

[source]
cast = "agent-session.cast"

[template]
name = "glass"

[output]
file   = "agent-demo.gif"
budget = "900kb"

[audio]
keyboard = "mx-brown"
---

trim    0.4s..end
speed   9x from 7.5s to 26.5s                    # the 19s thinking pause
caption "The 19s thinking pause, compressed 9x" at 8s for 2.4s
zoom    1.5x at (30,14) from 29.5s to 33.5s      # magnify the diff
caption "Zoom in on the money shot" at 30s for 2.2s
speed   3x from 34s to 41s                       # compile + tests
sound   "success" at 41.5s
freeze  last 1.4s
